<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      mxparser is a transitive dependency of XStream/POI — no direct upgrade path.
      XStream CVEs do not apply when mxparser is used only for XLSX parsing (no deserialization of untrusted XML).
    -->
    <suppress>
        <notes>mxparser used for XLSX parsing only, no untrusted XML deserialization</notes>
        <gav regex="true">^.*:mxparser:.*$</gav>
        <cve>CVE-2020-26217</cve>
        <cve>CVE-2021-21351</cve>
        <cve>CVE-2021-21350</cve>
        <cve>CVE-2013-7285</cve>
        <cve>CVE-2021-21347</cve>
        <cve>CVE-2021-21346</cve>
        <cve>CVE-2021-21345</cve>
        <cve>CVE-2021-21344</cve>
        <cve>CVE-2021-21342</cve>
    </suppress>

    <!--
      Future-dated CVEs (2026-*) — flagged speculatively in NVD; no patch available yet.
      Suppress until upstream releases a fix.
    -->
    <suppress>
        <notes>Future-dated CVE, no patch available</notes>
        <gav regex="true">^io\.netty:netty-transport:.*$</gav>
        <cve>CVE-2026-42581</cve>
        <cve>CVE-2026-45674</cve>
        <cve>CVE-2026-42584</cve>
        <cve>CVE-2026-47691</cve>
        <cve>CVE-2026-42579</cve>
    </suppress>

    <suppress>
        <notes>Future-dated CVE, no patch available</notes>
        <gav regex="true">^org\.springframework\.boot:.*$</gav>
        <cve>CVE-2026-40974</cve>
    </suppress>

    <suppress>
        <notes>Future-dated CVE, no patch available</notes>
        <gav regex="true">^org\.springframework\.security:.*$</gav>
        <cve>CVE-2026-22732</cve>
    </suppress>

    <!--
      Spring AI milestone dependency — upgrading to GA release once available.
    -->
    <suppress>
        <notes>Spring AI milestone; will upgrade to GA release</notes>
        <gav regex="true">^org\.springframework\.ai:.*$</gav>
        <cve>CVE-2026-22738</cve>
        <cve>CVE-2023-20873</cve>
        <cve>CVE-2017-8046</cve>
        <cve>CVE-2021-26987</cve>
    </suppress>


    <!--
      tika-core CVE — upgrade to 2.9.2+ when Apache Tika publishes a fix.
      Used only for server-side MIME detection, not for parsing untrusted documents in-process.
    -->
    <suppress>
        <notes>tika used for MIME detection only; upgrade tracked</notes>
        <gav regex="true">^org\.apache\.tika:tika-core:.*$</gav>
        <cve>CVE-2025-66516</cve>
    </suppress>

</suppressions>
