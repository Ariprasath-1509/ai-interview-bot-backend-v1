# Copy to .env and fill in values before running services locally.
# Never commit .env to version control.
# Full reference: docs/ENVIRONMENT.md

# Database (quote values containing # or spaces)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=aibot
DB_USER=aibot
DB_PASSWORD="aibot!@#%"

# JWT (minimum 32 characters)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
JWT_ISSUER=benchreadiness-auth
JWT_AUDIENCE=benchreadiness-api
JWT_ACCESS_EXPIRY_MS=1800000
JWT_REFRESH_EXPIRY_MS=604800000

# Auth protection
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=900
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Gateway service auth (leave empty for local dev without gateway key checks)
GATEWAY_SHARED_KEY=

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=learningdevelopment.tyss@gmail.com
MAIL_PASSWORD=xcbc bgrj lbql tgkd

# Claude API (optional)
APP_CLAUDE_API_KEY=
APP_CLAUDE_MODEL=claude-haiku-4-5
APP_CLAUDE_ASSESSMENT_MODEL=claude-sonnet-4-5
APP_LLM_PROVIDER=ollama
APP_OLLAMA_BASE_URL=http://localhost:11434

# CORS (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:6001,http://localhost:6101
